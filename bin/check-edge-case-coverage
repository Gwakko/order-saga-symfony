#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Checks that every edge case (EC-xx) in docs/spec/04_edge_cases.md references only tests
 * that exist as #[Group('T-...')] in tests/ or phpstan/.
 *
 * Usage:
 *   bin/check-edge-case-coverage             prints the table, exit code 1 if any EC has a missing test
 *   bin/check-edge-case-coverage --markdown  prints the table as Markdown (for docs/spec/08_coverage.md)
 *
 * Manual checks are never skipped silently: a row whose test cell mentions a manual step
 * ("ручной", "ревью") is flagged MANUAL and listed in the summary; @group slow is flagged SLOW.
 * The automatic part of such a row must still be found.
 */

const EC_FILE = 'docs/spec/04_edge_cases.md';
const SCAN_DIRS = ['tests', 'phpstan'];

/** @return array<string, array{files: list<string>, slow: bool}> */
function collectGroups(string $root): array
{
    $groups = [];
    foreach (SCAN_DIRS as $dir) {
        if (!is_dir($root . '/' . $dir)) {
            continue;
        }
        $iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($root . '/' . $dir, FilesystemIterator::SKIP_DOTS));
        foreach ($iterator as $file) {
            if (!$file instanceof SplFileInfo || 'php' !== $file->getExtension()) {
                continue;
            }
            $source = file_get_contents($file->getPathname());
            if (false === $source) {
                continue;
            }
            $slow = 1 === preg_match('/Group\(\'slow\'\)|@group\s+slow/', $source);
            $relative = substr($file->getPathname(), strlen($root) + 1);
            if (false === preg_match_all('/Group\(\'(T-[A-Z0-9]+-[0-9A-Za-z]+)\'\)/', $source, $matches)) {
                continue;
            }
            foreach ($matches[1] as $id) {
                $groups[$id] ??= ['files' => [], 'slow' => false];
                if (!in_array($relative, $groups[$id]['files'], true)) {
                    $groups[$id]['files'][] = $relative;
                }
                $groups[$id]['slow'] = $groups[$id]['slow'] || $slow;
            }
        }
    }

    return $groups;
}

/** @return list<string> */
function extractTestIds(string $cell): array
{
    // Ranges such as "T-M8A-06 … T-M8A-13" are expanded.
    $cell = (string) preg_replace_callback(
        '/(T-[A-Z0-9]+-)(\d+)\s*(?:…|\.\.\.)\s*T-[A-Z0-9]+-(\d+)/',
        static function (array $m): string {
            $ids = [];
            $width = strlen($m[2]);
            for ($i = (int) $m[2]; $i <= (int) $m[3]; ++$i) {
                $ids[] = $m[1] . str_pad((string) $i, $width, '0', STR_PAD_LEFT);
            }

            return implode(' ', $ids);
        },
        $cell,
    );
    preg_match_all('/T-[A-Z0-9]+-[0-9A-Za-z]+/', $cell, $matches);

    return array_values(array_unique($matches[0]));
}

$root = dirname(__DIR__);
$markdown = in_array('--markdown', $argv, true);
$spec = file_get_contents($root . '/' . EC_FILE);
if (false === $spec) {
    fwrite(STDERR, 'Cannot read ' . EC_FILE . "\n");
    exit(2);
}
$groups = collectGroups($root);

$rows = [];
foreach (explode("\n", $spec) as $line) {
    if (1 !== preg_match('/^\|\s*(EC-\d+[a-z]?)\s*\|/', $line, $m)) {
        continue;
    }
    $cells = array_map('trim', explode(' | ', trim($line, "| \t")));
    $testCell = (string) end($cells);
    $rows[] = ['ec' => $m[1], 'ids' => extractTestIds($testCell), 'manual' => 1 === preg_match('/ручн|ревью/u', $testCell)];
}

if ([] === $rows) {
    fwrite(STDERR, "No EC rows found\n");
    exit(2);
}

$missingRows = [];
$manualRows = [];
$slowRows = [];
$table = [];
foreach ($rows as $row) {
    $parts = [];
    $missing = [];
    $slow = false;
    foreach ($row['ids'] as $id) {
        $found = isset($groups[$id]);
        $slow = $slow || ($found && $groups[$id]['slow']);
        if (!$found) {
            $missing[] = $id;
        }
        $parts[] = $id . ($found ? '' : ' (НЕТ)');
    }
    if ([] === $row['ids']) {
        $missing[] = '(тест не указан)';
    }
    $flags = [];
    if ($row['manual']) {
        $flags[] = 'ручной';
        $manualRows[] = $row['ec'];
    }
    if ($slow) {
        $flags[] = 'slow';
        $slowRows[] = $row['ec'];
    }
    if ([] !== $missing) {
        $missingRows[] = $row['ec'] . ': ' . implode(', ', $missing);
    }
    $table[] = [$row['ec'], implode(', ', $parts), [] === $missing ? 'найден' : 'НЕ НАЙДЕН', implode(', ', $flags)];
}

if ($markdown) {
    echo "| EC | Тесты | Статус | Пометки |\n|---|---|---|---|\n";
    foreach ($table as $r) {
        echo '| ' . implode(' | ', $r) . " |\n";
    }
} else {
    foreach ($table as $r) {
        echo mb_str_pad($r[0], 8) . mb_str_pad($r[2], 11) . mb_str_pad($r[3], 14) . $r[1] . "\n";
    }
}

$total = count($rows);
$bad = count($missingRows);
echo "\nEC всего: {$total}; с найденными тестами: " . ($total - $bad) . "; без теста: {$bad}\n";
echo 'Ручные проверки (автоматическая часть тоже обязана быть найдена): ' . ([] === $manualRows ? 'нет' : implode(', ', $manualRows)) . "\n";
echo 'Медленные (@group slow, вне make ci, запуск make test-slow): ' . ([] === $slowRows ? 'нет' : implode(', ', $slowRows)) . "\n";
if ([] !== $missingRows) {
    echo "\nНЕ НАЙДЕНЫ:\n  " . implode("\n  ", $missingRows) . "\n";
    exit(1);
}
